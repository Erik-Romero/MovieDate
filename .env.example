# Copy to .env for local dev, and add the same two variables in
# Vercel -> Project -> Settings -> Environment Variables for deploys.
# Both come from Neon Console -> your project -> Auth / Data API.
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.<region>.aws.neon.tech/neondb/rest/v1
